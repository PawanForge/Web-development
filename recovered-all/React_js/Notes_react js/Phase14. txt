🔹 8. Controlled Login Form Example

function App(){
 const [name,setName] = useState("");
 const [pass,setPass] = useState("");

 const submit = (e)=>{
   e.preventDefault();
   console.log(name,pass);
 };

 return(
  <form onSubmit={submit}>
    <input type="text" placeholder="Enter Name" onChange={e=>setName(e.target.value)}/>
    <input type="password" placeholder="Enter Password" onChange={e=>setPass(e.target.value)}/>
    <button>Submit</button>
  </form>
 );
}


---

🔹 9. Controlled vs Uncontrolled

Controlled	Uncontrolled

Uses useState	Uses useRef
Re-render on change	No re-render
Validation easy	Fastest 


